# 이 파일을 .env 로 복사해서 쓴다. 없어도 기본값으로 동작한다.

# --- 서버 주소 (Vite 프록시 대상) ---
VITE_BACKEND_ORIGIN=http://localhost:8080
VITE_AI_ORIGIN=http://localhost:8000

# --- 클립을 어디서 가져올지 ---
#   mock     브라우저 메모리. 백엔드에 /api/clips 가 없을 때 (기본값)
#   backend  실제 백엔드 /api/clips
VITE_CLIP_SOURCE=mock

# --- 분석을 어디로 보낼지 ---
#   mock     브라우저 메모리 (기본값)
#   ai       AI 서버(8000)로 직접. 백엔드에 분석 API 가 생기기 전까지 쓰는 개발용 경로.
#            클립 영상을 AI 에 업로드하고 /api/tracks/manual 을 부른다.
#   backend  실제 백엔드 /api/clips/{id}/analysis  (정식 경로)
VITE_ANALYSIS_SOURCE=mock

# --- 라이브 HLS ---
#   /mock/hls/live.m3u8   로컬 파일 (scripts/make-mock-media.sh 로 생성)
#   /api/hls/live.m3u8    실서버
VITE_HLS_URL=/mock/hls/live.m3u8
