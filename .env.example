# 이 파일을 .env 로 복사해서 쓴다. 값이 없어도 기본값으로 동작한다.

# 백엔드 주소 (Vite 프록시 대상)
VITE_BACKEND_ORIGIN=http://localhost:8080

# 클립/분석 API 를 mock 으로 돌릴지 여부.
# 백엔드에 해당 API 가 생기면 false 로 바꾼다. 인증은 항상 실제 백엔드를 탄다.
VITE_USE_MOCK=true

# 라이브 HLS 주소.
#   mock  : /mock/hls/live.m3u8      (scripts/make-mock-media.sh 가 만든 로컬 파일)
#   실서버: /api/hls/live.m3u8       (프록시 경유)
#   공개 테스트 스트림 예시:
#     https://test-streams.mux.dev/x36xhzz/x36xhzz.m3u8
VITE_HLS_URL=/mock/hls/live.m3u8
